# 复制为 .env 后按需修改（.env 已被 gitignore）
# 线上（微信云托管）无需此文件，MySQL 连接由平台注入 MYSQL_* 变量

# 服务端口：本地 8080 可能被占用，这里用 18090；线上微信云托管用 80
PORT=18090

# 本地 MySQL（对应 deploy/docker-compose.yml 起的实例，宿主机端口映射为 3307）
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=root
DB_PASSWORD=munch123
DB_NAME=munch

# 自签 JWT 密钥，务必改成随机值
JWT_SECRET=please-change-this-to-a-random-secret

# 小程序凭证（做真实 code2session 登录时填）
WECHAT_APPID=
WECHAT_SECRET=

# 开发后门：允许 POST /api/login 直接用裸 openid 造用户，免微信环境。
# ⚠️ 仅本地开发用。线上（微信云托管）绝对不要设为 true，
#    否则任何人打这个接口就能伪造成你们任意一方的身份。
ALLOW_DEV_LOGIN=true

# 图片存储：local（默认，落磁盘）| cos（腾讯云对象存储）
STORAGE_DRIVER=local
STATIC_DIR=./data/uploads
# 本地磁盘存储时，拼接图片可访问地址的前缀（留空则返回相对路径 /static/xxx）
PUBLIC_BASE_URL=http://127.0.0.1:18090

# 腾讯云 COS（STORAGE_DRIVER=cos 时填）
# SecretId/SecretKey 是腾讯云账号级密钥（CAM → API密钥管理），建议用子用户密钥，
# 且该子用户需同时具备 COS 桶读写 + sts:GetFederationToken（签发临时密钥）权限。
# BUCKET_URL 是桶的访问域名，形如 https://<bucket>-<appid>.cos.<region>.myqcloud.com
# REGION / APPID 不填会从 BUCKET_URL 自动解析（region=ap-beijing, appid=桶名后缀）。
COS_SECRET_ID=
COS_SECRET_KEY=
COS_BUCKET_URL=https://ares1-1330007488.cos.ap-beijing.myqcloud.com
COS_REGION=
COS_APPID=https://ares1-1330007488.cos.ap-beijing.myqcloud.com
