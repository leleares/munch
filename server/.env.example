# 复制为 .env 后按需修改（.env 已被 gitignore）
# 线上（微信云托管）无需此文件，MySQL 连接由平台注入 MYSQL_* 变量

# 服务端口：本地开发用 8080，线上微信云托管用 80
PORT=8080

# 本地 MySQL（对应 deploy/docker-compose.yml 起的实例）
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=munch123
DB_NAME=munch

# 自签 JWT 密钥，务必改成随机值
JWT_SECRET=please-change-this-to-a-random-secret

# 小程序凭证（本地做 code2session 登录时填；仅用 openid 联调可不填）
WECHAT_APPID=
WECHAT_SECRET=

# 图片存储：local（默认，落磁盘）| cos（腾讯云对象存储）
STORAGE_DRIVER=local
STATIC_DIR=./data/uploads
# 本地磁盘存储时，拼接图片可访问地址的前缀（留空则返回相对路径 /static/xxx）
PUBLIC_BASE_URL=http://127.0.0.1:8080

# 腾讯云 COS（STORAGE_DRIVER=cos 时填）
COS_SECRET_ID=
COS_SECRET_KEY=
COS_BUCKET_URL=
